# Runtime mode.
# Defaults to legacy when omitted.
REPO_CONTEXT_AUTH_MODE=legacy

# GitHub App credentials shared by both modes
GITHUB_APP_ID=123456

# Absolute path to the GitHub App private key.
# Keep the PEM file outside this repository.
GITHUB_PRIVATE_KEY_PATH=/absolute/path/to/github-app.pem

# Legacy / single-repository mode only.
# These coordinates are not repository authorization in OAuth mode.
GITHUB_INSTALLATION_ID=12345678

# Legacy repository to expose through MCP
GITHUB_OWNER=your-github-user-or-org
GITHUB_REPO=your-repository
GITHUB_BRANCH=main

# Optional
PORT=3000

# Optional capability profiles. Legacy mode only.
# Leave empty for core tools only.
# Available: db, ui, history, workflow
REPO_CONTEXT_FEATURES=

# Optional repository issue index.
# Leave empty to use GitHub Issues only.
# Example: Backlog.md
ISSUE_INDEX_PATH=

# ============================================================
# OAuth / multi-user mode
# ============================================================
#
# Change:
#   REPO_CONTEXT_AUTH_MODE=oauth
#
# Repository access comes from the authenticated principal and
# encrypted RepositoryConnection records. The global
# GITHUB_INSTALLATION_ID / GITHUB_OWNER / GITHUB_REPO values above
# are legacy-only and are not authorization inputs in OAuth mode.

REPO_CONTEXT_MCP_URL=https://mcp.example.com/mcp

REPO_CONTEXT_OAUTH_ISSUER=https://auth.example.com/
REPO_CONTEXT_OAUTH_AUTHORIZATION_ENDPOINT=https://auth.example.com/authorize
REPO_CONTEXT_OAUTH_TOKEN_ENDPOINT=https://auth.example.com/oauth/token
REPO_CONTEXT_OAUTH_JWKS_URL=https://auth.example.com/.well-known/jwks.json

REPO_CONTEXT_CONNECTION_DB_PATH=/absolute/path/to/repository-connections.sqlite

# Generate these independently:
#   openssl rand -base64 32
REPO_CONTEXT_USER_LOOKUP_KEY=<base64-32-byte-key>
REPO_CONTEXT_CONNECTION_ENCRYPTION_KEY=<different-base64-32-byte-key>

# GitHub repository connect flow.
# These three values must either all be present or all be absent.
REPO_CONTEXT_GITHUB_APP_SLUG=your-github-app-slug
REPO_CONTEXT_GITHUB_CLIENT_ID=Iv1.example
REPO_CONTEXT_GITHUB_CLIENT_SECRET=<github-app-client-secret>

# Optional operator sensitive-data access.
# OAuth mode only.
#
# These three values must either all be present or all be absent.
#
# OPERATOR_ID is an audit label, not an authentication credential.
# OPERATOR_SUBJECT must exactly match the OAuth token `sub`.
# The issuer is REPO_CONTEXT_OAUTH_ISSUER.
#
# TOTP secret must be valid Base32 and decode to at least 20 bytes.
REPO_CONTEXT_OPERATOR_ID=
REPO_CONTEXT_OPERATOR_SUBJECT=
REPO_CONTEXT_OPERATOR_TOTP_SECRET=

# GitHub App URLs:
#
# Setup URL:
#   https://mcp.example.com/connect/github/setup
#
# Callback URL:
#   https://mcp.example.com/connect/github/callback

# Optional page rendering POC.
# Rendering remains disabled when this is unset.
# Must be an exact http(s) origin: scheme + host + optional port only.
# The MCP never installs or starts the target application.
# REPO_CONTEXT_RENDER_ORIGIN=http://127.0.0.1:5173
#
# Browser discovery and installation are intentionally not automatic.
# Configure an existing Chromium-compatible executable explicitly.
# REPO_CONTEXT_RENDER_BROWSER_EXECUTABLE=/absolute/path/to/browser
#
# OAuth mode only: bind the render target to one RepositoryConnection.
# Required when page rendering is enabled in OAuth mode.
# Do not set in legacy mode; legacy binds to its configured repository.
# REPO_CONTEXT_RENDER_REPOSITORY_ID=connection-id
